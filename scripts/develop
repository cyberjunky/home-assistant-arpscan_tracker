#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Use the project-local venv created by scripts/setup, if present.
if [ -f ".venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
fi

# Determine the Home Assistant command to use (need full path for sudo)
if command -v hass &> /dev/null; then
  HASS_CMD="$(which hass)"
else
  HASS_CMD="$(which python3) -m homeassistant"
fi

if [ ! -f "${PWD}/config/configuration.yaml" ]; then
  mkdir -p "${PWD}/config"
  ${HASS_CMD} --config "${PWD}/config" --script ensure_config
  echo "Updating default configuration."
  echo "
logger:
  default: info
  logs:
    custom_components.arpscan_tracker: debug"
fi

# Link our custom_components directory into the config directory so Home
# Assistant finds the integration. PYTHONPATH can't be used for this: sudo
# strips it from the environment, even with -E.
if [ ! -e "${PWD}/config/custom_components" ]; then
  ln -s ../custom_components "${PWD}/config/custom_components"
fi

# Start Home Assistant with sudo for raw socket access (ARP scanning)
sudo -E ${HASS_CMD} --config "${PWD}/config" --debug